# ==============================================================
# CLICK FRAME CINEMATIC — Serverless Email Delivery Configuration
# ==============================================================

# Resend API Key (Obtain from https://resend.com/api-keys)
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Optional: Custom Verified Sender Address
# Default if omitted: 'CLICK FRAME CINEMATIC <onboarding@resend.dev>'
# If you verify a custom domain on Resend (e.g., clickframecinematic.com):
# RESEND_FROM_EMAIL='Krupit Patel <inquiries@clickframecinematic.com>'
RESEND_FROM_EMAIL=

# Optional: Recipient Email Address
# Default if omitted: 'krupitpatel7kp@gmail.com'
# Note: For free/testing Resend accounts without a verified custom domain,
# Resend only permits sending to the email registered with your Resend account.
# Set this to your Resend account email (e.g. yugr9202@gmail.com) if testing without a verified domain.
RESEND_TO_EMAIL=
